{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Database Polling Connector",
  "id": "io.camunda.connector.dbpoller.v1",
  "version": 1,
  "description": "Periodically polls a JDBC database and correlates each row as a BPMN message.",
  "documentationRef": "https://github.com/camunda-community-hub/camunda-db-poller",
  "icon": {
    "contents": "data:image/svg+xml;base64,"
  },
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": ["bpmn:StartEvent", "bpmn:IntermediateCatchEvent"],
  "elementType": {
    "value": "bpmn:StartEvent",
    "eventDefinition": "bpmn:MessageEventDefinition"
  },
  "groups": [
    { "id": "connection",   "label": "Connection"          },
    { "id": "polling",      "label": "Polling"             },
    { "id": "consumption",  "label": "Consumption Strategy" },
    { "id": "watermark",    "label": "Watermark"           },
    { "id": "correlation",  "label": "Correlation"         },
    { "id": "resilience",   "label": "Resilience"          }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.camunda:camunda-db-poller:1",
      "binding": { "type": "zeebe:property", "name": "inbound.type" }
    },
    {
      "label": "JDBC URL",
      "description": "e.g. jdbc:postgresql://host:5432/mydb",
      "group": "connection",
      "type": "String",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.jdbcUrl" },
      "constraints": { "notEmpty": true }
    },
    {
      "label": "Username",
      "group": "connection",
      "type": "String",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.username" },
      "constraints": { "notEmpty": true }
    },
    {
      "label": "Password",
      "group": "connection",
      "type": "String",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.password" },
      "constraints": { "notEmpty": true }
    },
    {
      "label": "Dialect (auto-detect if blank)",
      "group": "connection",
      "type": "Dropdown",
      "value": "",
      "choices": [
        { "name": "Auto-detect", "value": "" },
        { "name": "PostgreSQL",  "value": "POSTGRES" },
        { "name": "MySQL",       "value": "MYSQL" },
        { "name": "H2",          "value": "H2" },
        { "name": "Oracle",      "value": "ORACLE" },
        { "name": "SQL Server",  "value": "SQLSERVER" },
        { "name": "SQLite",      "value": "SQLITE" }
      ],
      "binding": { "type": "zeebe:property", "name": "inbound.dialect" }
    },
    {
      "label": "Connection Timeout (ms)",
      "group": "connection",
      "type": "String",
      "value": "5000",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.connectionTimeoutMs" }
    },
    {
      "label": "Pool Max Size",
      "group": "connection",
      "type": "String",
      "value": "2",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.poolMaxSize" }
    },
    {
      "label": "Polling Query",
      "description": "SELECT query with :lastWatermark placeholder. Example: SELECT * FROM orders WHERE updated_at > :lastWatermark ORDER BY updated_at",
      "group": "polling",
      "type": "Text",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.pollingQuery" },
      "constraints": { "notEmpty": true }
    },
    {
      "label": "Polling Interval (seconds)",
      "group": "polling",
      "type": "String",
      "value": "30",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.pollingIntervalSeconds" }
    },
    {
      "label": "Batch Size",
      "group": "polling",
      "type": "String",
      "value": "100",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.batchSize" }
    },
    {
      "label": "Query Timeout (seconds)",
      "group": "polling",
      "type": "String",
      "value": "30",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.queryTimeoutSeconds" }
    },
    {
      "label": "Consumption Strategy",
      "description": "How a correlated row is marked so it isn't redelivered.",
      "group": "consumption",
      "type": "Dropdown",
      "value": "WATERMARK",
      "choices": [
        { "name": "Watermark column (default)",        "value": "WATERMARK" },
        { "name": "Update flag column after read",     "value": "UPDATE_FLAG" },
        { "name": "Delete row after read",              "value": "DELETE_AFTER_READ" }
      ],
      "binding": { "type": "zeebe:property", "name": "inbound.consumptionStrategy" }
    },
    {
      "label": "Target Table",
      "description": "Table the UPDATE/DELETE is issued against. The Polling Query may still join/filter freely.",
      "group": "consumption",
      "type": "String",
      "feel": "optional",
      "condition": { "property": "inbound.consumptionStrategy", "oneOf": ["UPDATE_FLAG", "DELETE_AFTER_READ"] },
      "binding": { "type": "zeebe:property", "name": "inbound.targetTable" }
    },
    {
      "label": "Key Column",
      "description": "Column that uniquely identifies a row, used to target the UPDATE/DELETE (single column only).",
      "group": "consumption",
      "type": "String",
      "feel": "optional",
      "condition": { "property": "inbound.consumptionStrategy", "oneOf": ["UPDATE_FLAG", "DELETE_AFTER_READ"] },
      "binding": { "type": "zeebe:property", "name": "inbound.keyColumn" }
    },
    {
      "label": "Flag Column",
      "description": "Boolean column flipped to TRUE immediately after a row is correlated.",
      "group": "consumption",
      "type": "String",
      "feel": "optional",
      "condition": { "property": "inbound.consumptionStrategy", "equals": "UPDATE_FLAG" },
      "binding": { "type": "zeebe:property", "name": "inbound.flagColumn" }
    },
    {
      "label": "Watermark Column",
      "description": "Column name used to track polling progress (e.g. updated_at)",
      "group": "watermark",
      "type": "String",
      "feel": "optional",
      "condition": { "property": "inbound.consumptionStrategy", "equals": "WATERMARK" },
      "binding": { "type": "zeebe:property", "name": "inbound.watermarkColumn" },
      "constraints": { "notEmpty": true }
    },
    {
      "label": "Watermark Type",
      "group": "watermark",
      "type": "Dropdown",
      "value": "TIMESTAMP",
      "choices": [
        { "name": "Timestamp",   "value": "TIMESTAMP" },
        { "name": "Big Integer", "value": "BIGINT" },
        { "name": "UUID",        "value": "UUID" },
        { "name": "String",      "value": "STRING" }
      ],
      "condition": { "property": "inbound.consumptionStrategy", "equals": "WATERMARK" },
      "binding": { "type": "zeebe:property", "name": "inbound.watermarkType" }
    },
    {
      "label": "Initial Watermark",
      "description": "Starting value for the watermark. Leave blank for type-appropriate default (EPOCH / 0 / nil UUID / empty string).",
      "group": "watermark",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "condition": { "property": "inbound.consumptionStrategy", "equals": "WATERMARK" },
      "binding": { "type": "zeebe:property", "name": "inbound.initialWatermark" }
    },
    {
      "label": "Watermark Storage",
      "description": "Where the watermark is persisted between polls.",
      "group": "watermark",
      "type": "Dropdown",
      "value": "IN_MEMORY",
      "choices": [
        { "name": "In-memory (lost on restart)",      "value": "IN_MEMORY" },
        { "name": "Durable (JDBC table)",              "value": "JDBC_TABLE" }
      ],
      "condition": { "property": "inbound.consumptionStrategy", "equals": "WATERMARK" },
      "binding": { "type": "zeebe:property", "name": "inbound.watermarkStorage" }
    },
    {
      "label": "Watermark Table Name",
      "description": "Operator-created table holding durable watermarks (see README for DDL). Must already exist.",
      "group": "watermark",
      "type": "String",
      "value": "camunda_db_poller_watermark",
      "feel": "optional",
      "condition": { "property": "inbound.watermarkStorage", "equals": "JDBC_TABLE" },
      "binding": { "type": "zeebe:property", "name": "inbound.watermarkTableName" }
    },
    {
      "label": "Instance ID",
      "description": "Logical identifier included in every RowPayload metadata block.",
      "group": "watermark",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "binding": { "type": "zeebe:property", "name": "inbound.instanceId" }
    },
    {
      "label": "Correlation Key",
      "description": "FEEL expression to extract the correlation key from the row payload.",
      "group": "correlation",
      "type": "String",
      "feel": "required",
      "binding": { "type": "zeebe:property", "name": "correlationKey" },
      "constraints": { "notEmpty": true }
    },
    {
      "label": "Message ID",
      "description": "FEEL expression for deduplication message ID (optional).",
      "group": "correlation",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "binding": { "type": "zeebe:property", "name": "messageId" }
    },
    {
      "label": "Activation Condition",
      "description": "FEEL expression evaluated on the row payload; message is only correlated when true.",
      "group": "correlation",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "binding": { "type": "zeebe:property", "name": "activationCondition" }
    },
    {
      "label": "Result Variable",
      "description": "Process variable name to store the correlated row payload.",
      "group": "correlation",
      "type": "String",
      "feel": "optional",
      "optional": true,
      "binding": { "type": "zeebe:property", "name": "resultVariable" }
    },
    {
      "label": "Max Consecutive Failures",
      "group": "resilience",
      "type": "String",
      "value": "5",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.maxConsecutiveFailures" }
    },
    {
      "label": "Circuit Breaker Threshold",
      "description": "Consecutive failures before health is reported as DOWN.",
      "group": "resilience",
      "type": "String",
      "value": "10",
      "feel": "optional",
      "binding": { "type": "zeebe:property", "name": "inbound.circuitBreakerThreshold" }
    }
  ]
}

